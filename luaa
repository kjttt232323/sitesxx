-- ===== HITBOX EXPANDER =====
local hbWhitelist = {}
local hbOriginal = {}
local hbEnabled = false

local function storeOrig(player)
    if not player.Character then return end
    local root = player.Character:FindFirstChild("HumanoidRootPart")
    if root and not hbOriginal[player] then
        hbOriginal[player] = {
            Size = root.Size,
            Transparency = root.Transparency,
            CanCollide = root.CanCollide,
            CanTouch = root.CanTouch,
            CanQuery = root.CanQuery
        }
    end
end

local function restorePlayer(player)
    local props = hbOriginal[player]
    if props and player.Character then
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            root.Size = props.Size
            root.Transparency = props.Transparency
            root.CanCollide = props.CanCollide
            root.CanTouch = props.CanTouch
            root.CanQuery = props.CanQuery
        end
    end
end

local hbSize = 4
local hbTrans = 0.5

local function applyHB(player)
    if player == LocalPlayer or not hbWhitelist[player] then return end
    if not player.Character then return end
    local root = player.Character:FindFirstChild("HumanoidRootPart")
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end
    storeOrig(player)
    root.Size = Vector3.new(hbSize, hbSize, hbSize)
    root.Transparency = hbTrans
    root.CanCollide = false
    root.CanTouch = true
    root.CanQuery = true
    for _, part in ipairs(player.Character:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function checkKnocked(player)
    local live = getLive()
    if not live then return true end
    local entry = live:FindFirstChild(player.Name)
    if not entry then return true end
    local knocked = entry:FindFirstChild("Knocked")
    return not (knocked and knocked:IsA("BoolValue") and knocked.Value)
end

local function evalPlayer(player)
    if player == LocalPlayer or not player.Character then return end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        hbWhitelist[player] = nil
        restorePlayer(player)
        return
    end
    if checkKnocked(player) then
        hbWhitelist[player] = true
        applyHB(player)
    else
        hbWhitelist[player] = nil
        restorePlayer(player)
    end
end

-- Monitor players
local hbConns = {}
local function hbMonitor(player)
    hbConns[player] = hbConns[player] or {}
    local c = hbConns[player]
    local function setup(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        if c.hp then c.hp:Disconnect() end
        if c.dd then c.dd:Disconnect() end
        c.hp = hum.HealthChanged:Connect(function() evalPlayer(player) end)
        c.dd = hum.Died:Connect(function()
            hbWhitelist[player] = nil
            restorePlayer(player)
        end)
        evalPlayer(player)
    end
    if player.Character then setup(player.Character) end
    c.ca = player.CharacterAdded:Connect(setup)
end

Players.PlayerAdded:Connect(hbMonitor)
Players.PlayerRemoving:Connect(function(p)
    hbWhitelist[p] = nil
    restorePlayer(p)
    if hbConns[p] then
        for _, conn in pairs(hbConns[p]) do
            if conn and conn.Disconnect then pcall(conn.Disconnect, conn) end
        end
    end
    hbConns[p] = nil
end)
for _, p in ipairs(Players:GetPlayers()) do hbMonitor(p) end

-- ===== PUNCH / STOMP SPEED =====
local punchSpeed = 1.7
local stompSpeed = 1.5

local function smoothSpeed(track, target)
    if not track or not track.IsPlaying then return end
    local curr = track.Speed
    local step = (target - curr) / 6
    task.spawn(function()
        for i = 1, 6 do
            if not track or not track.IsPlaying then break end
            pcall(function() track:AdjustSpeed(curr + (step * i)) end)
            task.wait(0.02)
        end
        pcall(function() track:AdjustSpeed(target) end)
    end)
end

-- Detect if a track is a punch/stomp by name (FIAS uses these names)
local function isCombatTrack(track)
    if not track then return false end
    if not track.Animation then return false end
    local id = tostring(track.Animation.AnimationId):lower()
    local name = track.Name:lower()
    -- Generic: any track containing punch/m1/attack/stomp/slam in the name
    if string.find(name, "punch") or string.find(name, "m1")
        or string.find(name, "attack") or string.find(name, "combo")
        or string.find(name, "stomp") or string.find(name, "slam")
        or string.find(name, "ground") then
        return "punch"
    end
    if string.find(name, "stomp") or string.find(name, "slam")
        or string.find(name, "ground") then
        return "stomp"
    end
    return false
end

local punchConns = {}
local function hookPunchSpeed()
    local model = getMyModel()
    if not model then
        if not punchConns.liveWatch then
            punchConns.liveWatch = Workspace.ChildAdded:Connect(function(ch)
                if ch.Name == "Live" then task.defer(hookPunchSpeed) end
            end)
        end
        return
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if not anim then return end

    if punchConns.ac then punchConns.ac:Disconnect() end
    if punchConns.ap then punchConns.ap:Disconnect() end

    for _, t in ipairs(anim:GetPlayingAnimationTracks()) do
        local kind = isCombatTrack(t)
        if kind == "punch" then smoothSpeed(t, punchSpeed)
        elseif kind == "stomp" then smoothSpeed(t, stompSpeed) end
    end

    punchConns.ac = anim.ChildAdded:Connect(function(ch)
        if ch:IsA("AnimationTrack") then
            local kind = isCombatTrack(ch)
            if kind == "punch" then smoothSpeed(ch, punchSpeed)
            elseif kind == "stomp" then smoothSpeed(ch, stompSpeed) end
        end
    end)

    punchConns.ap = hum.AnimationPlayed:Connect(function(t)
        local kind = isCombatTrack(t)
        if kind == "punch" then smoothSpeed(t, punchSpeed)
        elseif kind == "stomp" then smoothSpeed(t, stompSpeed) end
    end)

    if punchConns.an then punchConns.an:Disconnect() end
    punchConns.an = model.AncestryChanged:Connect(function(_, p)
        if not p then task.defer(hookPunchSpeed) end
    end)
end

task.defer(hookPunchSpeed)

-- ===== WEAVE BOOST (works) =====
local weaveBoost = 4
local weaveBoostOn = false

local function hookWeaveBoost(char)
    local root = char:WaitForChild("HumanoidRootPart", 8)
    if not root then return end
    root.ChildAdded:Connect(function(child)
        if not weaveBoostOn then return end
        if child:IsA("BodyPosition") then
            local target = child.Position
            local origin = root.Position
            local delta = target - origin
            local dist = delta.Magnitude
            if dist > 0.1 and dist < 50 then
                pcall(function()
                    child.Position = origin + (delta.Unit * (dist * weaveBoost / 2.5))
                end)
            end
        elseif child:IsA("BodyVelocity") then
            pcall(function() child.MaxForce = child.MaxForce * weaveBoost end)
        end
    end)
end

if LocalPlayer.Character then hookWeaveBoost(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(hookWeaveBoost)

-- ============================================================
-- THREE-LAYER AUTO WEAVE DETECTION
-- ============================================================

local autoWeaveOn = false
local weaveCooldown = 0.4
local weaveReactDelay = 0.04
local lastWeave = 0

local function fireWeave()
    local now = tick()
    if now - lastWeave < weaveCooldown then return end
    lastWeave = now
    task.spawn(function()
        fireKey(Enum.KeyCode.Q, 45)
    end)
end

-- Layer 1: Generic attack animation detection (no hardcoded IDs)
-- Fires when ANY nearby player starts a new animation within attack range
local activeAttacks = {}  -- track which players are currently attacking

local function detectAttackAnimations()
    local live = getLive()
    if not live then return end
    local myRoot = getMyRoot()
    if not myRoot then return end

    for _, entry in ipairs(live:GetChildren()) do
        if entry.Name ~= LocalPlayer.Name then
            local root = entry:FindFirstChild("HumanoidRootPart")
            local hum = entry:FindFirstChildOfClass("Humanoid")
            local anim = hum and hum:FindFirstChildOfClass("Animator")
            if root and hum and anim and hum.Health > 0 then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist < 22 then -- attack range
                    -- Check for newly started animations
                    for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
                        if isCombatTrack(track) and track.TimePosition < 0.3 then
                            if not activeAttacks[entry] then
                                activeAttacks[entry] = tick()
                                if autoWeaveOn then
                                    task.wait(weaveReactDelay)
                                    fireWeave()
                                end
                            end
                        end
                    end
                else
                    activeAttacks[entry] = nil
                end
            end
        end
    end
end

-- Layer 2: Velocity shock detection
-- When your character suddenly gets knocked back, you got hit
local lastVelocity = Vector3.new(0, 0, 0)
local velocityThreshold = 35  -- studs/sec sudden change

local function checkVelocityShock()
    local root = getMyRoot()
    if not root then return end
    local currentVel = root.AssemblyLinearVelocity
    local delta = (currentVel - lastVelocity).Magnitude
    if delta > velocityThreshold and autoWeaveOn then
        -- Check we're not moving fast from our own dash
        local myHum = getMyHumanoid()
        if myHum and myHum:GetState() ~= Enum.HumanoidStateType.Freefall then
            task.wait(weaveReactDelay)
            fireWeave()
        end
    end
    lastVelocity = currentVel
end

-- Layer 3: Stun value watcher
-- When stun/hit/daze values get added to your character
local stunHooked = false
local function hookStunValues()
    task.spawn(function()
        while true do
            local model = getMyModel()
            if model and not model:FindFirstChild("CS_StunWatch") then
                local marker = Instance.new("BoolValue")
                marker.Name = "CS_StunWatch"
                marker.Parent = model

                model.ChildAdded:Connect(function(child)
                    if not autoWeaveOn then return end
                    local name = string.lower(child.Name)
                    if string.find(name, "stun") or string.find(name, "hit")
                        or string.find(name, "daze") or string.find(name, "ragdoll")
                        or string.find(name, "knocked") or string.find(name, "hurt") then
                        task.wait(weaveReactDelay)
                        if autoWeaveOn then fireWeave() end
                    end
                end)
            end
            task.wait(2)
        end
    end)
end

task.defer(hookStunValues)

