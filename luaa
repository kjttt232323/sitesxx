-- ===== AUTO CONNECT (aim snap) =====
local autoConnectOn = false
local acRange = 18

local function getNearestPlayer(maxRange)
    local live = getLive()
    if not live then return nil end
    local myRoot = getMyRoot()
    if not myRoot then return nil end
    local best, bestDist = nil, maxRange
    for _, entry in ipairs(live:GetChildren()) do
        if entry.Name ~= LocalPlayer.Name then
            local root = entry:FindFirstChild("HumanoidRootPart")
            local hum = entry:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local knocked = entry:FindFirstChild("Knocked")
                if not (knocked and knocked:IsA("BoolValue") and knocked.Value) then
                    local dist = (root.Position - myRoot.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = root
                    end
                end
            end
        end
    end
    return best
end

local function snapAim()
    local target = getNearestPlayer(acRange)
    if not target then return end
    local myRoot = getMyRoot()
    if not myRoot then return end
    pcall(function()
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, target.Position)
    end)
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if not autoConnectOn then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.KeyCode == Enum.KeyCode.ButtonR2 then
        snapAim()
    end
end)

-- ===== AUTO BLOCK =====
local autoBlockOn = false

local function fireBlock(state)
    task.spawn(function()
        fireKey(Enum.KeyCode.F, state and 400 or 45)
    end)
end

task.spawn(function()
    while true do
        if autoBlockOn then
            local live = getLive()
            local myRoot = getMyRoot()
            if live and myRoot then
                local threat = false
                for _, entry in ipairs(live:GetChildren()) do
                    if entry.Name ~= LocalPlayer.Name then
                        local root = entry:FindFirstChild("HumanoidRootPart")
                        local hum = entry:FindFirstChildOfClass("Humanoid")
                        local anim = hum and hum:FindFirstChildOfClass("Animator")
                        if root and hum and anim and hum.Health > 0 then
                            local dist = (root.Position - myRoot.Position).Magnitude
                            if dist < 22 then
                                for _, t in ipairs(anim:GetPlayingAnimationTracks()) do
                                    if isCombatTrack(t) and t.TimePosition < 0.3 then
                                        threat = true
                                        break
                                    end
                                end
                            end
                        end
                        if threat then break end
                    end
                end
                if threat then
                    fireBlock(true)
                    task.wait(0.4)
                    fireBlock(false)
                    task.wait(0.2)
                end
            end
        end
        task.wait(0.05)
    end
end)

