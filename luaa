local autoCritOn = false

local function isCritReady()
    local model = getMyModel()
    if not model then return false end
    local names = {"CritReady", "CriticalReady", "CanCrit", "CritAvailable", "CritWindow"}
    for _, name in ipairs(names) do
        local obj = model:FindFirstChild(name)
        if obj then
            if obj:IsA("BoolValue") and obj.Value then return true end
            if obj:IsA("NumberValue") and obj.Value > 0 then return true end
        end
    end
    return false
end

task.spawn(function()
    while true do
        if autoCritOn then
            local target = getNearestPlayer(20)
            if target and isCritReady() then
                task.spawn(function() fireKey(Enum.KeyCode.E, 50) end)
                task.wait(0.5)
            end
        end
        task.wait(0.05)
    end
end)

-- ===== CD BYPASS =====
local cdBypassOn = false

local function findCD()
    local model = getMyModel()
    if not model then return nil end
    for _, desc in ipairs(model:GetDescendants()) do
        local name = string.lower(desc.Name)
        if string.find(name, "cooldown") or string.find(name, "debounce") then
            return desc
        end
    end
    return nil
end

task.spawn(function()
    while true do
        if cdBypassOn then
            local tracker = findCD()
            if tracker then
                pcall(function()
                    if tracker:IsA("NumberValue") then tracker.Value = 0
                    elseif tracker:IsA("BoolValue") then tracker.Value = false
                    elseif tracker:IsA("IntValue") then tracker.Value = 0 end
                end)
            end
        end
        task.wait(0.2)
    end
end)

