-- ===== INPUT METHOD DETECTION =====
local InputMethod = "vim"
local pressKey, releaseKey

if keypress and keyrelease then
    InputMethod = "native"
    pressKey = function(k) pcall(keypress, k) end
    releaseKey = function(k) pcall(keyrelease, k) end
elseif keypress then
    InputMethod = "native_stateful"
    pressKey = function(k) pcall(keypress, k, true) end
    releaseKey = function(k) pcall(keypress, k, false) end
end

local function fireKey(keyEnum, holdMs)
    holdMs = holdMs or 45
    -- Native OS-level
    if InputMethod == "native" or InputMethod == "native_stateful" then
        pcall(pressKey, keyEnum)
        task.wait(holdMs / 1000)
        pcall(releaseKey, keyEnum)
    else
        -- VIM fallback
        local VIM = game:GetService("VirtualInputManager")
        pcall(function() VIM:SendKeyEvent(true, keyEnum, false, game) end)
        task.wait(holdMs / 1000)
        pcall(function() VIM:SendKeyEvent(false, keyEnum, false, game) end)
    end
end

